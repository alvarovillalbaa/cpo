+
+
+@pytest.mark.parametrize('first_perfect', (False, True))
+def test_paired_opening_keeps_both_winners_and_resumes_at_the_first_reflection(first_perfect):
+    training = (Row('t1', 'task', fields=1), Row('t2', 'task', fields=1))
+    validation = (Row('v1', 'task', fields=1), Row('v2', 'task', fields=1))
+    paid, proposals, scheduled = set(), [], []
+    grades = {
+        'start': set(),
+        'rewrite': {'t1', 'v1', 'v2'} if first_perfect else {'t1', 'v1'},
+        'repair': {'t2', 'v2'},
+        'winner': {'t2', 'v1', 'v2'},
+    }
+
+    def evaluate(prompt, row):
+        assert (prompt, row.id) not in paid
+        paid.add((prompt, row.id))
+        passed = row.id in grades[prompt]
+        return Observation(passed, {}, int(passed))
+
+    def schedule(index, pool, _grades):
+        scheduled.append((index, pool))
+        return ('start', (('t1',), ('t2',))) if index == 0 else ('rewrite', ('t2',))
+
+    def propose(index, parent, samples):
+        proposals.append((index, parent, samples[0][0].id))
+        return ('rewrite', 'repair', 'winner')[index]
+
+    def charge(index, *_):
+        return int(index >= 2)
+
+    budget = SequentialSearchBudget(20, 1, charge, charge)
+    result = select_sequential_field_rewrites(
+        'start', training, validation, evaluate, schedule, propose, rounds=3, minibatch_size=1,
+        metric_limit=18, observed_charge=lambda *_: 1, price_budget=budget, reinvest_savings=True, paired_opening=True,
+    )
+    assert scheduled[0] == (0, ('start',))
+    assert proposals[0] == (0, 'start', 't1')
+    if first_perfect:
+        assert result == 'rewrite'
+        assert len(scheduled) == len(proposals) == 1
+        assert ('start', 't2') not in paid
+    else:
+        assert result == 'winner'
+        assert scheduled[1:] == [(2, ('start', 'rewrite', 'repair'))]
+        assert proposals[1:] == [(1, 'start', 't2'), (2, 'rewrite', 't2')]
